# Copy this file to .env and fill in your key:   cp .env.example .env
# .env is listed in .gitignore, so it never gets uploaded to GitHub.
ANTHROPIC_API_KEY=paste-your-key-here
# Your time zone (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/London
# The mini PC's address on your network (used for Bolt's HTTPS certificate).
BOLT_ADDRESS=192.168.4.58
# The "door number" Bolt's web page uses. Pick a different number if another
# program on the mini PC already uses this one.
BOLT_PORT=8770

# --- Phone notifications through Home Assistant (optional, see LEARN.md) ---
# The address of Home Assistant on your network (the same one you use in a browser):
HA_URL=http://192.168.4.58:8123
# A long-lived access token from HA (Profile → Security → Long-lived access tokens).
# Treat it like a password: it can control your whole home.
HA_TOKEN=
# Your phone's notify action, e.g. mobile_app_lukes_phone
# (HA → Developer tools → Actions → search "notify.mobile_app")
HA_NOTIFY=
# Kinds of device Bolt may NEVER see or control (comma-separated).
# Worth considering: lock,alarm_control_panel,cover,script,automation
HA_BLOCKED_DOMAINS=lock

# --- Voice (see LEARN.md) ---
# Whisper model: tiny-int8 (about 2x faster, a bit less accurate), base-int8 (default), small-int8 (most accurate, slowest)
WHISPER_MODEL=base-int8
# How many guesses Whisper tries: 1 is fastest. Higher (e.g. 5) can be slightly more accurate but slower.
WHISPER_BEAM=1
# Extra Whisper settings. --vad-filter skips silence and background noise before listening.
WHISPER_OPTIONS=--vad-filter
# Words Whisper should expect (names, rooms, devices), so it picks the right ones.
WHISPER_HINT=Riley. Home Assistant. Logs, lights, heating, reminders, memories.
# Piper voice. Listen to them at https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_GB-alan-medium

# The news Riley plays after the morning briefing (a podcast's RSS feed, https only).
# The default is BBC World Service's Global News Podcast. NEWS_FEED=off switches it off.
NEWS_FEED=https://podcasts.files.bbci.co.uk/p02nq0gn.rss
# How many minutes of it to play before fading out (1 to 30).
NEWS_MINUTES=5
