# Settings for Bolt's body. The installer copies this to bolt.env. Edit THAT one.

# Where Bolt's brain lives (the mini PC):
BRAIN_URL=https://192.168.4.58:8770

# Bolt's HTTPS "stamp", so the Pi can check it's really talking to Bolt (see LEARN.md).
BOLT_CA=/home/luke/robotFriend/pi/bolt-ca.crt

# The key that lets the Pi past the brain's lock. Get it on the mini PC with:
#   docker exec bolt python -m robot_friend.security show-key
# Treat it like a password.
BOLT_KEY=

# The wake word. "hey_jarvis" works now; swap in hey_bolt.onnx once it's trained.
# For "Hey Bolt": the path to your trained model, e.g. /home/you/robotFriend/pi/hey_bolt.onnx
# (see LEARN.md, "The wake word"), and a lower threshold like 0.3.
WAKE_MODEL=hey_jarvis
# 0 to 1. Raise it if Bolt wakes up by mistake; lower it if it doesn't hear you.
WAKE_THRESHOLD=0.5

# Volume, sleep time, wake sensitivity and replies can also be set in the Studio (Body tab):
# once saved there, the Studio's values win over this file.

# Optional: a push-to-talk button wired to this GPIO pin (e.g. 17). Leave empty for none.
BUTTON_PIN=
# The touch screen's T_IRQ wire (GPIO 22 = pin 15). Tap to talk, hold 5 seconds to turn off.
# Leave empty if your screen has no touch layer.
TOUCH_IRQ_PIN=22
# Have to press really hard? Try off (uses the screen board's own pull-up only):
# python -m bolt_body.touch compare   tells you which works better.
TOUCH_PULL_UP=on
# The camera (Camera Module 3). CAMERA=off to ignore it. Upside down in the head? CAMERA_ROTATION=180
CAMERA=on
CAMERA_ROTATION=0

# Optional: sound card names, if the defaults don't work (see LEARN.md).
MIC_DEVICE=
SPEAKER_DEVICE=

# The 2.8" screen (see LEARN.md, "Bolt's face on the screen"). SCREEN=off if there isn't one.
SCREEN=on
SCREEN_MHZ=12
# 90 or 270: which way up (swap them if the face is upside down)
SCREEN_ROTATION=90
# Minutes with nobody talking before Bolt dozes off
SLEEP_AFTER_MINUTES=10

# What Bolt says when it hears its name, separated by | (empty = a soft chime instead)
ACK_PHRASES=Yes?|Mm-hm?|I'm listening.|What's up?|Hi!
