# Settings for Bolt's body. The installer copies this to bolt.env. Edit THAT one.

# Where Bolt's brain lives (the mini PC):
BRAIN_URL=http://192.168.4.58:8770

# The key that lets the Pi past the brain's lock. Get it on the mini PC with:
#   docker exec bolt python -m robot_friend.security show-key
# Treat it like a password.
BOLT_KEY=

# The wake word. "hey_jarvis" works now; swap in hey_bolt.onnx once it's trained.
WAKE_MODEL=hey_jarvis
# 0 to 1. Raise it if Bolt wakes up by mistake; lower it if it doesn't hear you.
WAKE_THRESHOLD=0.5

# Optional: a push-to-talk button wired to this GPIO pin (e.g. 17). Leave empty for none.
BUTTON_PIN=

# Optional: sound card names, if the defaults don't work (see LEARN.md).
MIC_DEVICE=
SPEAKER_DEVICE=
